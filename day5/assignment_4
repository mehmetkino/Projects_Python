def get_float(min_value, max_value, entry):
    value = float(input(f"Enter {entry}\n"))
    while value < min_value or value >max_value:
        print(f"Enter a value within range of {min_value} to {max_value}\n")
        value = float(input(f"Enter {entry}\n"))
    return value

def get_integer(min_value, max_value, entry):
    value = int(input(f"Enter {entry}\n"))
    while value < min_value or value >max_value:
        print(f"Enter a value within range of {min_value} to {max_value}\n")
        value = int(input(f"Enter {entry}\n"))
    return value

def is_valid_value(first, second, entry):
    value = input(f"{entry} ").lower()
    while value != first and value != second:
        print("Enter a value between range of {first} or {second}\n")
        value = input(f"{entry}\n").lower()
    return value
def calc_future_value(investment, rate, years):
    monthly_rate, months = enhancement.convert_to_monthly_values(rate,years)
    future_value = 0
    for i in range(months):
        future_value = (future_value + investment)* (1 + monthly_rate)
    return future_value


def main():
    display_company_information()
    
    keep_going = "y"
